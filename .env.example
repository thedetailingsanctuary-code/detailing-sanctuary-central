# Copy to .env.local for local use, or add each one in Vercel > Project > Settings > Environment Variables.
# Never commit real values. See docs/SETUP.md for where each value comes from.

# --- App ---
# Public URL of the deployed app, no trailing slash (used for Microsoft redirect + notification links)
APP_BASE_URL=https://your-app.vercel.app
# Long random string (32+ chars). Signs the login cookie and encrypts stored Microsoft tokens.
#   PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
SESSION_SECRET=
# Long random string. Protects the scheduled rain-check endpoint. Vercel Cron sends it automatically.
CRON_SECRET=

# --- Microsoft Entra ID (single-tenant app registration) ---
MS_TENANT_ID=            # Directory (tenant) ID - the GUID
MS_CLIENT_ID=            # Application (client) ID
MS_CLIENT_SECRET=        # Client secret VALUE (not the secret ID)
ALLOWED_USER_EMAIL=      # The one Microsoft 365 account allowed in, e.g. DetailMyCar@DetailingSanctuary.co.uk
# ALLOWED_USER_OID=      # Optional: lock to the account's Object ID instead of the email

# --- Supabase ---
SUPABASE_URL=            # Project Settings > API > Project URL
SUPABASE_SERVICE_ROLE_KEY=   # Project Settings > API > service_role (server only - never in the browser)

# --- Firebase Cloud Messaging (push) ---
# Server side: the whole service-account JSON on one line, or base64 of it.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Browser side (public by design): the web app config from Firebase console as JSON on one line.
NEXT_PUBLIC_FIREBASE_CONFIG_JSON={"apiKey":"...","authDomain":"...","projectId":"...","messagingSenderId":"...","appId":"..."}
# Browser side: Cloud Messaging > Web Push certificates > key pair (public key)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Weather ---
WEATHER_PROVIDER=open-meteo

# --- Local preview only (ignored in production builds) ---
# DEMO_MODE=true          # skip sign-in and use sample bookings on this machine
# NEXT_PUBLIC_SW_DEV=true # register the service worker in "npm run dev" (normally production only)
